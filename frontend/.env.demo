# DEMO MODE: `npm run build:demo` (vite build --mode demo) loads this file. The bundle runs without a
# backend: an in-page demo backend (src/demo/) answers every API call from real engine output captured
# once from the Python backend (backend/scripts/capture_demo_data.py -> src/demo/demo-data.json).
VITE_DEMO_MODE=true
# The API client still builds /api/v1/... URLs; the demo transport routes on the path after /api/v1.
VITE_API_BASE_URL=/api/v1
# Top-bar environment badge (the captured plant is the dev seed; the DEMO badge is added by VITE_DEMO_MODE)
VITE_APP_ENV=dev
