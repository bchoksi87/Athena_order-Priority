# Copy to .env for docker-compose / local development. Never commit real secrets.

# --- Database (docker-compose) ---
POSTGRES_USER=ppse
POSTGRES_PASSWORD=ppse
POSTGRES_DB=ppse
POSTGRES_PORT=5432

# --- Backend ---
PPSE_ENVIRONMENT=dev                 # dev | test | prod
PPSE_DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:5432/ppse
PPSE_TEST_DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:5432/ppse_test
PPSE_JWT_SECRET=change-me-in-production
PPSE_JWT_EXPIRE_MINUTES=480
PPSE_LOG_LEVEL=INFO
PPSE_LOG_JSON=false
PPSE_CORS_ORIGINS=["http://localhost:5173","http://localhost:8080"]

# ERP connector: "mock" serves the synthetic dataset (read-only). Real connectors are registered
# in app/integration/connector.py (see docs/ERP_INTEGRATION.md).
PPSE_ERP_CONNECTOR=mock
PPSE_SYNTHETIC_SCALE=medium          # small | medium | large
PPSE_SYNTHETIC_SEED=42

# Writeback ladder: read_only -> approval -> writeback -> controlled_auto (docs/ERP_INTEGRATION.md)
PPSE_WRITEBACK_MODE=read_only

# Background jobs (ERP sync, continuous replanning, alert evaluation)
PPSE_BACKGROUND_JOBS_ENABLED=false
PPSE_SYNC_INTERVAL_MINUTES=15
PPSE_REPLAN_INTERVAL_MINUTES=30

PPSE_CURRENCY=INR

# --- Ports (docker-compose) ---
BACKEND_PORT=8000
FRONTEND_PORT=8080

# --- Frontend (Vite dev) ---
VITE_API_BASE_URL=/api/v1
